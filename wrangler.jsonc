{
  "name": "drjennyleiclinic",
  "compatibility_date": "2026-01-01",
  // worker.js：把舊的 workers.dev 網址 301 轉到 jennyleiclinic.com（說明在 worker.js 開頭）
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // 每個請求都先經過 worker.js，才能依網址判斷要不要轉址
    "run_worker_first": true
  }
}
